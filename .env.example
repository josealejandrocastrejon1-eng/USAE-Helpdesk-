# ==========================================
# USAE Helpdesk — Variables de Entorno
# Copia este archivo a .env y completa los secretos reales.
# Nunca subas credenciales reales al repositorio.
# ==========================================

# Entorno de ejecución (development | production)
NODE_ENV="development"
PORT="3000"
APP_URL="http://localhost:3000"

# Secreto criptográfico para firma de sesiones/tokens (mínimo 32 caracteres aleatorios en producción)
SESSION_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS"

# Semilla de demostración (solo habilitar explícitamente en desarrollo/pruebas; NUNCA en producción)
ALLOW_DEMO_SEED="true"

# Administrador inicial en producción (se usa una sola vez si la tabla users está vacía y ALLOW_DEMO_SEED != true)
ADMIN_BOOTSTRAP_EMAIL=""
ADMIN_BOOTSTRAP_PASSWORD=""
ADMIN_BOOTSTRAP_NAME="Administrador USAE"

# Mercado Pago (requerido para cobro automatizado en línea)
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""

# Correo SMTP (requerido para envío real de verificación, alertas y notificaciones)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="soporte.helpdesk.usae@gmail.com"

# Google Drive (Módulo 03 - Respaldo externo de evidencias)
GOOGLE_DRIVE_FOLDER_ID=""
GOOGLE_SERVICE_ACCOUNT_JSON=""

# WhatsApp Business API (opcional - requiere plantilla autorizada)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Datos SPEI institucionales (se muestran únicamente dentro del checkout autenticado)
SPEI_BANK_NAME="Configurar banco receptor en Administración o .env"
SPEI_CLABE=""
SPEI_ACCOUNT_HOLDER="USAE Soluciones Tecnológicas"

# Límite máximo por archivo adjunto en MB (predeterminado: 10)
MAX_UPLOAD_MB="10"

# Gemini API (opcional - solo si se habilitan herramientas de apoyo administrativo)
GEMINI_API_KEY=""
